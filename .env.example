# Copy to .env.local and fill in. Never commit real values.

# TiDB Cloud (MySQL compatible). Use a dedicated database, never `sys`.
DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=drug_master_platform
DB_SSL=true

# Generate with: pnpm keys:generate
SESSION_SECRET=
APP_ENCRYPTION_KEY=

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# One-time central admin bootstrap.
# Leave BOOTSTRAP_ADMIN_PASSWORD empty and a random password is generated and
# printed once. Set it only for a local database; it is refused when
# NODE_ENV=production.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# TMT API — server-side only.
TMT_API_BASE=https://tmt.this.or.th/tmtapi
TMT_API_USER=
TMT_API_PASSWORD=

# Experimental read-only TMT Browser v2. Leave disabled until migrations
# 0014/0015, a successful v2 sync, and invariant review are complete.
TMT_V2_BROWSER_ENABLED=0
TMT_V2_MAPPING_ENABLED=0
TMT_V2_CATALOG_ENABLED=0
TMT_V2_EXPORT_ENABLED=0
ACTIVE_STANDARD_RELEASE_ENABLED=0

# Fallback only. Set the installer download link on the admin screen instead
# ("ผู้ดูแลระบบ" -> "ตัวติดตั้ง Agent"); that needs no redeploy to change.
NEXT_PUBLIC_AGENT_INSTALLER_URL=
